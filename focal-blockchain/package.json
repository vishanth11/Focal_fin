{
  "name": "focal-blockchain",
  "version": "1.0.0",
  "description": "FOCAL blockchain module - Soulbound NFT badges for verified companies",
  "main": "scripts/blockchainHelper.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:mumbai": "hardhat run scripts/deploy.js --network mumbai",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "mint:amoy": "hardhat run scripts/mintBadge.js --network amoy",
    "verify:amoy": "hardhat verify --network amoy",
    "verify:mumbai": "hardhat verify --network mumbai",
    "verify:sepolia": "hardhat verify --network sepolia",
    "generate-metadata": "node scripts/generateMetadata.js",
    "upload-pinata": "node scripts/uploadToPinata.js",
    "update-uri": "hardhat run scripts/updateBadgeURI.js --network amoy"
  },
  "keywords": [
    "focal",
    "nft",
    "soulbound",
    "polygon",
    "ethereum",
    "hardhat",
    "openzeppelin"
  ],
  "author": "FOCAL Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "ethers": "^6.11.0"
  }
}

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated list of allowed origins (backend + local frontends)
ML_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (per client IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60

# Model
MODEL_PATH=models/text_classifier.pkl
VECTORIZER_PATH=models/vectorizer.pkl

# External APIs (optional — leave blank if not using)
PHISHTANK_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Thresholds
LOW_RISK_THRESHOLD=30
MEDIUM_RISK_THRESHOLD=60
MIN_DOMAIN_AGE_DAYS=30

# GST verification. Keep provider credentials server-side.
GST_API_PROVIDER=mock
GST_API_KEY=
GST_API_SECRET=
GST_API_URL=https://api.cleartax.in/v2/gstin

# Server
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB for hackathon demos:
MONGODB_URI=mongodb://127.0.0.1:27017/focal
# MongoDB Atlas format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.<cluster-id>.mongodb.net/focal?retryWrites=true&w=majority

# Blockchain (Polygon Amoy testnet)
RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0x9124A20aE4a715Fcee6056bf1F5f95E4358647C6
ADMIN_PRIVATE_KEY=0xYourAdminPrivateKey
ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddress

# Demo company onboarding. 'true' enables the demo verification flow and the
# wallet-signed demo badge mint endpoint (/api/companies/:id/mint-badge).
# The mint itself is always a REAL Polygon Amoy transaction. Unset/false =
# production pipeline only (register -> pending -> admin review -> mint).
DEMO_VERIFICATION_MODE=false

# Pinata credentials for real OMEN metadata uploads. Keep these backend-only.
PINATA_JWT=YOUR_PINATA_JWT
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET_API_KEY=YOUR_PINATA_SECRET_API_KEY
# Optional absolute path; defaults to focal-blockchain/assets/green-badge.svg.
BADGE_IMAGE_PATH=

# JWT
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@focal.network
ADMIN_PASSWORD=change_this_strong_password

# Optional. Signs student tokens ONLY. Students are entirely separate from the
# admin account above and never hold admin permissions. Leave unset and student
# tokens fall back to JWT_SECRET; set it to give student auth its own secret.
STUDENT_JWT_SECRET=

# ML API (base URL — the backend appends /predict and /health)
ML_API_URL=http://localhost:8000

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# External APIs (optional)
PHISHTANK_API_KEY=your_key
GOOGLE_SAFE_BROWSING_API_KEY=your_key
VIRUSTOTAL_API_KEY=your_key
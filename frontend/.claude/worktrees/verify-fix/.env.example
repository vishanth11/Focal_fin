# FOCAL Frontend Environment
# Copy this file to .env and fill in your values.

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Deployed OMEN Company Badge contract address (Polygon Amoy testnet).
VITE_CONTRACT_ADDRESS=0x9124A20aE4a715Fcee6056bf1F5f95E4358647C6
VITE_CHAIN_ID=80002

# Polygon Amoy RPC endpoint
VITE_RPC_URL=https://rpc-amoy.polygon.technology

# Set to true to serve hardcoded demo data when the backend is unreachable.
# Leave false for the real end-to-end integration — failures then surface as errors.
VITE_USE_DEMO=false

# Build-time default for demo verification mode. The frontend refreshes this
# from the backend's GET /api/config at runtime; this value only controls the
# first paint and the fallback when the backend is unreachable.
VITE_DEMO_VERIFICATION_MODE=false